# Copied to .env by install-on-unas.sh, which fills in APPS_ROOT and random
# passwords. Keep .env private (it holds the MongoDB passwords).

APPS_ROOT=/volume/<pool-uuid>/.unas-apps/data
TZ=Europe/Berlin

# LAN for the macvlan network. LAN_PARENT is the UNAS LAN port.
LAN_PARENT=enp0s1
LAN_SUBNET=192.168.0.0/23
LAN_GATEWAY=192.168.1.1
# DNS for the containers (written to ./resolv.conf); several: "a.b.c.d e.f.g.h"
LAN_DNS=192.168.1.1

# Fixed addresses outside the DHCP range, with fixed MACs so a DHCP
# reservation or a test lease can follow them.
UNIFI_IP=192.168.1.2
UNIFI_MAC=02:42:c0:a8:01:02
LOXBERRY_IP=192.168.1.3
LOXBERRY_MAC=02:42:c0:a8:01:03

MONGO_ROOT_PASS=
MONGO_PASS=
