#!/bin/bash
# Fixed-release safety boundary. Only read-only profile validation is allowed.
# Firmware arguments are always refused, including when stale arm files exist.
set -Eeuo pipefail
export LC_ALL=C
umask 077
readonly runtime=/data/unvr-unas-runtime
readonly log_file=$runtime/guarded-fwupdate.log
readonly physical_5_1_33=UNVR4.al324.v5.1.33.44ce47b.260909.0025
readonly kernel_mount=/mnt/unvr-unas-update-check
readonly apt_valid_until_policy=/etc/apt/apt.conf.d/10validuntil
readonly apt_valid_until_policy_sha256=92dd8add3f0093b490c4d4c57f6a2bc7afc1a7519b078b8034db2df5add7f458
kernel_mounted=false

sha256() { sha256sum "$1" | awk '{print $1}'; }

normalized_fdt_sha256() {
    python3 -c 'import sys; data=sys.stdin.buffer.read(); assert data.count(b"reboot=warm") + data.count(b"reboot=cold") == 1; sys.stdout.buffer.write(data.replace(b"reboot=warm", b"reboot=cold"))' \
        < /sys/firmware/fdt | sha256sum | awk '{print $1}'
}

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$log_file"; }

refuse() {
    log "REFUSED: $*"
    printf 'Guarded UNVR-to-UNAS updater refused: %s\n' "$*" >&2
    exit 64
}

pkg_version() { dpkg-query -W -f='${Version}' "$1" 2>/dev/null || true; }

require_equal() { [[ "$1" == "$2" ]] || refuse "$3"; }

require_file_hash() {
    local file=$1 expected=$2 label=$3
    [[ -f "$file" && ! -L "$file" ]] || refuse "$label is missing or unsafe"
    require_equal "$(sha256 "$file")" "$expected" "$label hash mismatch"
}

require_file_hash_one_of() {
    local file=$1 label=$2 actual allowed
    shift 2
    [[ -f "$file" && ! -L "$file" ]] || refuse "$label is missing or unsafe"
    actual=$(sha256 "$file")
    for allowed in "$@"; do
        [[ "$actual" == "$allowed" ]] && return 0
    done
    refuse "$label hash mismatch"
}

validate_drive_scoped_system_info() {
    local source=/proc/ubnthal/system.info target=$runtime/drive-system.info
    [[ -f "$source" ]] || refuse "physical system information is unavailable"
    [[ -f "$target" && ! -L "$target" ]] || refuse "Drive-scoped system information is missing or unsafe"
    [[ "$(sed -n 's/^shortname=//p' "$source")" == UNVR4 ]] \
        || refuse "physical system is not the validated four-bay UNVR"
    cmp -s "$target" <(awk -F= '
        $1 == "shortname" { print "shortname=UNASPRO"; next }
        $1 == "name"      { print "name=UniFi Network Attached Storage Pro"; next }
        { print }
    ' "$source") || refuse "Drive-scoped system information differs from the physical source overlay"
}

cleanup() {
    if [[ "$kernel_mounted" == true ]] && mountpoint -q "$kernel_mount"; then
        umount "$kernel_mount" || true
    fi
}

validate_physical_identity() {
    local uboot_hash index expected_size expected_name physical_version
    require_equal "$(uname -m)" aarch64 "architecture mismatch"
    require_equal "$(sed -n 's/^shortname=//p' /proc/ubnthal/system.info | head -n1)" UNVR4 "physical console is not the four-bay UNVR"
    require_equal "$(blockdev --getsize64 /dev/boot)" 31268536320 "internal boot-medium geometry mismatch"
    while IFS='|' read -r index expected_size expected_name; do
        [[ -r "/sys/class/mtd/mtd$index/size" && -r "/sys/class/mtd/mtd$index/name" && -r "/dev/mtd$index" ]] \
            || refuse "required MTD partition is missing: mtd$index"
        require_equal "$(cat "/sys/class/mtd/mtd$index/size")" "$expected_size" "MTD partition size mismatch: mtd$index"
        require_equal "$(cat "/sys/class/mtd/mtd$index/name")" "$expected_name" "MTD partition name mismatch: mtd$index"
    done <<'EOF'
0|1835008|u-boot
1|65536|u-boot env
2|65536|u-boot env redundant
3|65536|Factory
4|65536|EEPROM
5|16777216|recovery kernel
6|14680064|config
EOF
    uboot_hash=$(sha256 /dev/mtd0)
    physical_version=$(cat /usr/lib/version 2>/dev/null || true)
    case "$physical_version" in
        "$physical_5_1_33")
            require_equal "$uboot_hash" 95ab38b870eb3886f35a6411244f99596d9788e165c84b8ff3b6e522b3d5f2a6 \
                "signed UNVR 5.1.33 U-Boot MTD mismatch"
            require_equal "$(sha256 /dev/mtd1)" de2f256064a0af797747c2b97505dc0b9f3df0de4f489eac731c23ae9ca9cc31 \
                "UNVR 5.1.33 primary U-Boot environment is not in the signed updater reset state"
            require_equal "$(sha256 /dev/mtd2)" de2f256064a0af797747c2b97505dc0b9f3df0de4f489eac731c23ae9ca9cc31 \
                "UNVR 5.1.33 redundant U-Boot environment is not in the signed updater reset state"
            ;;
        *)
            case "$uboot_hash" in
                6006a0aae68b096e44973eae9b57e44add48d894d06c95c4702c21e0b0dfb762|\
                b8e936e52355819bb113c165f3b29e635ac9d821d03e7921159aad43690e719f) ;;
                *) refuse "U-Boot MTD mismatch" ;;
            esac
            ;;
    esac
    case "$(sha256 /dev/mtd5)" in
        dadcfc457787621b42e7eeb9266810a5e8ae1c329d4402d2793fb508943794e9|\
        99798c2755f72343e75915365f3e9a074379b12b28e058b3c2182af416adcc5c) ;;
        *) refuse "recovery kernel mismatch" ;;
    esac
}

validate_boot_files() {
    local active_root=$1 backup_root=$2 config_hash=$3 active_kernel=$4 backup_kernel=$5
    require_equal "$(sha256 /boot/firmware/rootfs)" "$active_root" "active rootfs mismatch"
    if [[ "$backup_root" == RECORDED ]]; then
        local recorded_backup_root recorded_backup_version
        [[ -f "$runtime/recovery/rootfs-source.bkp.sha256" ]] || refuse "recorded source-rootfs hash is missing"
        [[ -f "$runtime/recovery/rootfs-source.bkp.version" ]] || refuse "recorded source-rootfs version is missing"
        recorded_backup_root=$(cat "$runtime/recovery/rootfs-source.bkp.sha256")
        recorded_backup_version=$(cat "$runtime/recovery/rootfs-source.bkp.version")
        [[ "$recorded_backup_root" =~ ^[0-9a-f]{64}$ ]] || refuse "recorded source-rootfs hash is malformed"
        [[ "$recorded_backup_version" == UNVR4.al324.v* ]] || refuse "recorded source-rootfs version is not a UNVR image"
        require_equal "$(sha256 /boot/firmware/rootfs.bkp)" "$recorded_backup_root" "recorded fallback rootfs mismatch"
        require_equal "$(head -c 4 /boot/firmware/rootfs.bkp | od -An -tx1 | tr -d ' \n')" 68737173 "recorded fallback rootfs is not SquashFS"
    else
        require_equal "$(sha256 /boot/firmware/rootfs.bkp)" "$backup_root" "fallback rootfs mismatch"
    fi
    require_equal "$(zcat /proc/config.gz | sha256sum | awk '{print $1}')" "$config_hash" "kernel configuration mismatch"
    require_equal "$(normalized_fdt_sha256)" 508b402774e14e66d3a692f3593ad804f9425eece7bd287617189d19c281f222 "device tree mismatch after reboot-mode normalization"
    install -d -m 0700 "$kernel_mount"
    ! mountpoint -q "$kernel_mount" || refuse "kernel validation mount point is already in use"
    mount -o ro /dev/boot1 "$kernel_mount"
    kernel_mounted=true
    require_file_hash "$kernel_mount/uImage" "$active_kernel" "active UNVR kernel image"
    if [[ "$backup_kernel" == RECORDED ]]; then
        local recorded_backup_hash
        [[ -f "$runtime/recovery/uImage-source.bkp.sha256" ]] || refuse "recorded source-kernel hash is missing"
        recorded_backup_hash=$(cat "$runtime/recovery/uImage-source.bkp.sha256")
        [[ "$recorded_backup_hash" =~ ^[0-9a-f]{64}$ ]] || refuse "recorded source-kernel hash is malformed"
        require_file_hash "$kernel_mount/uImage.bkp" "$recorded_backup_hash" "stock updater recorded source-kernel backup"
        require_file_hash "$runtime/recovery/uImage-source.bkp" "$recorded_backup_hash" "offline recorded source-kernel backup"
    elif [[ "$backup_kernel" != NONE ]]; then
        require_file_hash "$kernel_mount/uImage.bkp" "$backup_kernel" "stock updater kernel backup"
    fi
    require_file_hash "$runtime/recovery/uImage-5.1.33" 158688310a8fbef461c2f72a1d05326a246bcfa8525e3dc77177454853c462da "offline signed baseline kernel copy"
    umount "$kernel_mount"
    kernel_mounted=false
}

