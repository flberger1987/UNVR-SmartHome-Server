    require_equal "$(pkg_version unifi-hal:arm64)" 1.0.0-1378+ga49db765b339 "HAL 5.x version mismatch"
    require_equal "$(pkg_version ubnt-tools)" 5.1.11~556+g3abf3fe "ubnt-tools 5.x version mismatch"
    require_equal "$(sudo -u postgres psql -X -d unifi-drive -A -F '|' -t -c 'SELECT version,dirty FROM schema_migrations' 2>/dev/null || true)" "$expected_schema" "Drive $drive_version schema migration is incomplete"
    require_equal "$(cat "$runtime/logical-target" 2>/dev/null || true)" "$logical_target" "logical target marker mismatch"
    require_equal "$(cat "$runtime/completed-update" 2>/dev/null || true)" "$expected_completion" "final completion marker is missing"
    [[ ! -e "$runtime/pending-update" ]] || refuse "final state still has a pending-update marker"
    [[ ! -e "$runtime/allow-base-update-4.3.10" &&
       ! -e "$runtime/allow-userspace-update-5.1.32" ]] \
        || refuse "final state still has an obsolete update arm file"
    [[ ! -e "$runtime/allow-base-update-5.1.33" ]] || refuse "obsolete OS update arm file is present"
    storage_mode=$(cat "$runtime/storage-mode" 2>/dev/null || true)
    case "$storage_mode" in managed|deferred) ;; *) refuse "final storage mode is missing or invalid" ;; esac
    validate_services_and_storage "$expected_core_profile" multi "$storage_mode"

    owner=$(sudo -u postgres psql -X -d ulp-go -A -t -c \
        'SELECT unique_id FROM "user" WHERE deleted_at IS NULL LIMIT 1' 2>/dev/null || true)
    [[ -n "$owner" ]] || refuse "current ULP owner record is unavailable"
    system_info=$(curl -fsS -H "X-UserId: $owner" http://127.0.0.1:16080/api/v1/systems/info 2>/dev/null || true)
    jq -e --arg drive_version "$drive_version" --arg logical_target "$logical_target" '
        .data.console.model == "UNASPRO" and
        .data.firmwareVersion == $logical_target and
        .data.version == $drive_version and
        .data.features.storage.pool.supported == true and
        .data.modelSpecs.storage.fileSystem == "Btrfs"
    ' <<<"$system_info" >/dev/null || refuse "Drive frontend feature profile is not final UNAS $logical_target"
    storage_v2=$(curl -fsS http://127.0.0.1:16080/api/v2/storage 2>/dev/null || true)
    if [[ "$storage_mode" == managed ]]; then
        jq -e '
            (.pools | any(
                .capacity > 0 and
                .initializingStatus == "successful" and
                (.status == "healthy" or .status == "noDataProtectionYet")
            )) and
            (.disks | any(.slotId == "1" and .state == "optimal"))
        ' <<<"$storage_v2" >/dev/null || refuse "Drive frontend storage v2 endpoint is not healthy"
    else
        jq -e '(.pools | type) == "array" and (.disks | type) == "array" and
            (.pools | all(.initializingStatus != "inProgress"))' <<<"$storage_v2" >/dev/null \
            || refuse "Drive frontend deferred-storage endpoint is not ready"
    fi
    log "validated final logical UNAS $logical_target profile on physical $physical_label"
}

trap cleanup EXIT HUP INT TERM
[[ $# == 1 && "$1" == --profile-check ]] \
    || refuse 'OS firmware updates are disabled for the pinned UNAS Pro 5.1.33 release'
require_equal "$(cat /usr/lib/version)" "$physical_5_1_33" "physical baseline is not the pinned UNVR 5.1.33 release"
validate_physical_identity
validate_restore_payload
validate_final
printf 'GUARDED_PROFILE_CHECK_OK stage=final physical=UNVR-5.1.33 logical=UNASPRO-5.1.33 drive=%s\n' "$(pkg_version unifi-drive)"
