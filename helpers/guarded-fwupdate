validate_services_and_storage() {
    local expected_core_hash=$1 layout=$2 storage_mode=${3:-managed} target source lv_path owner storage state
    [[ ! -e /var/run/fwupdate.pid ]] || refuse "another firmware update is active"
    ! pgrep -x fwupdate >/dev/null || refuse "fwupdate process is active"
    [[ ! -e /boot/firmware/rootfs.new ]] || refuse "an incomplete rootfs update is present"
    for unit in unifi-core unifi-drive usd uhwd ulp-go nginx; do
        systemctl is-active --quiet "$unit" || refuse "$unit is not active"
    done
    grep -qw fuse /proc/modules || refuse "FUSE module is not loaded"
    [[ -c /dev/fuse ]] || refuse "FUSE device is unavailable"
    local failed_unit
    while read -r failed_unit; do
        [[ -z "$failed_unit" || "$failed_unit" == postgresql-cluster-14-protect-cleanup.service ]] \
            || refuse "unexpected failed unit: $failed_unit"
    done < <(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')

    case "$layout" in
        legacy)
            systemctl is-active --quiet smbd || refuse "smbd is not active"
            target=$(findmnt -rn -S /dev/md3 -o TARGET,FSTYPE 2>/dev/null \
                | awk '$2 == "btrfs" { print $1; exit }')
            [[ -n "$target" ]] || refuse "existing md3 Btrfs storage is not mounted"
            [[ "$target" == /volume1 ]] || refuse "legacy storage is not mounted at /volume1"
            grep -qE '^md0 : active raid1 ' /proc/mdstat || refuse "md0 is not active RAID1"
            ;;
        multi)
            case "$storage_mode" in
                managed)
                    systemctl is-active --quiet smbd || refuse "smbd is not active"
                    target=$(findmnt -rn -t btrfs -o TARGET 2>/dev/null \
                        | awk '$1 ~ /^\/volume\// { print $1; exit }')
                    [[ -n "$target" ]] || refuse "LVM-backed Btrfs storage is not mounted"
                    [[ "$target" == /volume/* ]] || refuse "storage is not mounted in the 5.1 multi-volume tree"
                    [[ "$(pvs --noheadings -o pv_name 2>/dev/null | awk '{$1=$1; print}')" == /dev/md3 ]] \
                        || refuse "LVM physical volume is not the validated md3 array"
                    [[ "$(vgs --noheadings -o vg_name 2>/dev/null | sed '/^[[:space:]]*$/d' | wc -l)" == 1 ]] \
                        || refuse "unexpected LVM volume-group topology"
                    lv_path=$(lvs --noheadings -o lv_path 2>/dev/null | awk '{$1=$1; print}')
                    [[ "$lv_path" == /dev/*/* && "$lv_path" != *$'\n'* ]] \
                        || refuse "unexpected LVM logical-volume topology"
                    source=$(findmnt -rn -T "$target" -o SOURCE 2>/dev/null)
                    source=${source%%\[*}
                    [[ "$(readlink -f "$source")" == "$(readlink -f "$lv_path")" ]] \
                        || refuse "mounted Btrfs source is not the validated LVM volume"
                    grep -qE '^md3 : active raid1 ' /proc/mdstat || refuse "md3 is not active RAID1"
                    ;;
                deferred) ;;
                *) refuse "unknown storage readiness mode: $storage_mode" ;;
            esac
            systemctl is-active --quiet wsdd-server udcd || refuse "Drive support services are not active"
            require_equal "$(pkg_version lvm2)" 2.03.11-2.1 "official UNAS LVM2 version mismatch"
            require_equal "$(pkg_version dmeventd)" 2:1.02.175-2.1 "official UNAS LVM event daemon version mismatch"
            require_file_hash /sbin/lvm d61b5933ae9e91f087eaa6941354b072ee23140477418de3996e3593bebd8570 "official UNAS LVM executable"
            ;;
        *) refuse "unknown storage layout profile" ;;
    esac
    [[ "$layout" != legacy ]] || grep -qE '^md3 : active raid1 ' /proc/mdstat || refuse "md3 is not active RAID1"

    if [[ "$layout" == multi && "$storage_mode" == managed ]]; then
        state=$(/usr/bin/node24 "$runtime/query-drive-storage-state" 2>/dev/null || true)
        jq -e '
            (.poolsList | any(
                .totalBytes > 0 and
                .initializationStatus == 2 and
                (.status as $status | ([6, 7, 17] | index($status)) != null) and
                (.diskIdsList | length) >= 1
            )) and
            (.disksList | any(.slotId == 1 and .status == 4))
        ' <<<"$state" >/dev/null || refuse "Drive storage v2 state is not healthy"
    elif [[ "$layout" == multi ]]; then
        state=$(/usr/bin/node24 "$runtime/query-drive-storage-state" 2>/dev/null || true)
        jq -e '
            (.poolsList | type) == "array" and
            (.disksList | type) == "array" and
            (.poolsList | all(.initializationStatus != 1))
        ' <<<"$state" >/dev/null || refuse "Drive deferred-storage state is not ready"
    else
        owner=$(sudo -u postgres psql -X -d unifi-drive -A -t -c 'SELECT id FROM users LIMIT 1' 2>/dev/null || true)
        [[ -n "$owner" ]] || refuse "Drive owner record is unavailable"
        storage=$(curl -fsS -H "X-UserId: $owner" http://127.0.0.1:16080/api/v1/systems/storage 2>/dev/null || true)
        state=$(curl -fsS -H "X-UserId: $owner" http://127.0.0.1:16080/api/sys/storage/state 2>/dev/null || true)
        jq -e '((((try .data.status catch null) // .status) == "healthy") or ((.data | type) == "array" and any(.data[]; (.status == "healthy") or (.health == "health"))))' <<<"$storage" >/dev/null || refuse "Drive storage is not healthy"
        jq -e '(.data.ready // .ready) == true' <<<"$state" >/dev/null || refuse "Drive storage is not ready"
    fi

    grep -q '^  schedule: null$' /data/unifi-core/config/firmware.yaml || refuse "console automatic updates are not disabled"
    grep -q '^  includeApplications: false$' /data/unifi-core/config/firmware.yaml || refuse "application automatic updates are not disabled"
    python3 - <<'PY' || refuse "application-specific automatic update schedules are not disabled"
import yaml
with open('/data/unifi-core/config/apps.userPrefs.yaml') as stream:
    preferences = yaml.safe_load(stream)
assert isinstance(preferences, dict)
schedules = preferences['updateSchedules']
assert isinstance(schedules, dict) and all(value is None for value in schedules.values())
PY
    require_file_hash /usr/share/unifi-core/app/service.js "$expected_core_hash" "active Core UNAS identity"
}

validate_final() {
    local owner system_info storage_v2 drive_version expected_drive_hash expected_schema storage_mode
    local logical_target expected_completion active_root backup_root config_hash active_kernel backup_kernel expected_uos expected_uboot expected_core_profile physical_label
    logical_target=5.1.33
    physical_label=UNVR-5.1.33
    expected_completion='physical=UNVR-5.1.33 logical=UNASPRO-5.1.33 state=complete'
    active_root=e29dd4200a24106a8aadefc6122a145c2510570f39173b993bf595bde9a75944
    backup_root=RECORDED
    config_hash=6e7bcbc5c1779103dfadcf7b49a1c3e50e49c647bb0284ff478781e0888b3f6c
    active_kernel=158688310a8fbef461c2f72a1d05326a246bcfa8525e3dc77177454853c462da
    backup_kernel=RECORDED
    expected_uos=5.1.5
    expected_uboot=95ab38b870eb3886f35a6411244f99596d9788e165c84b8ff3b6e522b3d5f2a6
    expected_core_profile=a65c0736fd0abad3df5cc4cd1a42549cacc84e1b76f07ff30eff5cd1d75a774b
    require_equal "$(uname -r)" 4.19.152-alpine-unvr "5.x kernel baseline mismatch"
    require_equal "$(sha256 /dev/mtd0)" "$expected_uboot" "5.1 U-Boot MTD mismatch"
    validate_boot_files \
        "$active_root" \
        "$backup_root" \
        "$config_hash" \
        "$active_kernel" \
        "$backup_kernel"
    require_equal "$(pkg_version unifi-core)" 5.1.132 "Core 5.x version mismatch"
    require_equal "$(pkg_version uos)" "$expected_uos" "UOS utility version mismatch"
    drive_version=$(pkg_version unifi-drive)
    case "$drive_version" in
        4.3.10)
            expected_drive_hash=b26ed8c0e33bd44a6daf83b2b123513c231665161a9a2b2a70bd852bf5bd4b0a
            expected_schema='123|f'
            ;;
        4.4.9)
            expected_drive_hash=1a1265721040fa1c39ec6d6c121eff14db5ae4d8d26491888d0cc017839f3142
            expected_schema='129|f'
            ;;
        *) refuse "final Drive version is not compatibility-profiled: $drive_version" ;;
    esac
    require_file_hash /usr/share/unifi-drive/bin/unifi-drive "$expected_drive_hash" "official Drive $drive_version executable"
    require_equal "$(pkg_version unifi-drive-config)" 2.23.0-11+ga8a43c45ecd7 "final Drive Config version mismatch"
    require_equal "$(pkg_version unifi-drive-rclone)" 1.74.4-1+g2b3bd0b0f35e "final Drive rclone version mismatch"
