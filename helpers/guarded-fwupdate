    require_file_hash "$runtime/query-drive-storage-state" dd90cb4319ae43fb15a1c3c5635f540c0cb4f138e0741c08fcab7ebc62a156c9 "Drive storage v2 verifier"
    require_file_hash "$runtime/packages/wsdd_0.8.deb" bf96efcca6bf2993262d095e6c3cf2cbb7e527a4bf21ce747a865f5b3d7668d2 "official UNAS wsdd package"
